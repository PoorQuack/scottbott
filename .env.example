# =============================================================================
# Scottbott — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored; this template is the safe-to-commit version.
# =============================================================================

# === Discord ===
# Get from https://discord.com/developers/applications -> your bot -> Bot tab
DISCORD_BOT_TOKEN=replace-me-with-your-discord-bot-token
# Your own Discord user ID (right-click yourself in Discord with dev mode on)
CREATOR_DISCORD_USER_ID=000000000000000000

# === Google Gemini API ===
# Get from https://aistudio.google.com/ — used for chat, image generation, and music generation
GOOGLE_API_KEY=AIza-replace-me-with-your-google-api-key

# === Chat configuration ===
NIM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
NIM_MODEL_LIGHT=gemini-2.5-flash
NIM_MODEL_HEAVY=gemini-2.5-pro
NIM_MODEL=gemini-2.5-flash

# === Image generation ===
IMAGE_GENERATION_MODEL=gemini-3.1-flash-image-preview

# === Music generation (Lyria 3) ===
# Note: Lyria 3 requires billing enabled on your Google Cloud project.
# If you don't enable billing, the !scott song command will return "no audio".
# Other features (text chat, image generation) work fine on the free tier.
SONG_GENERATION_MODEL_CLIP=lyria-3-clip-preview
SONG_GENERATION_MODEL_PRO=lyria-3-pro-preview

# === Generation parameters ===
SCOTT_TEMPERATURE=0.7
SCOTT_TOP_P=0.9
SCOTT_MAX_TOKENS=2000
NIM_TIMEOUT=1200
CHANNEL_CONTEXT_MESSAGES=15
SAFETY_SETTINGS=BLOCK_NONE

# === Bot personality ===
# Customize these to give your bot a different character.
BOT_PERSONALITY_NAME=Scottbott
BOT_PERSONALITY_TRAITS=judgemental, sarcastic
BOT_PERSONALITY_TONE=friendly but with dark humor, you go straight to the point, avoid cringe statements and cliche phrases
BOT_PERSONALITY_BACKSTORY=A Discord bot created to assist users while keeping things entertaining
BOT_PERSONALITY_LANGUAGE_STYLE=Casual
