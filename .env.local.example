# Add these to your .env file to enable local SDXL v17

# Set to true to use local WAI-NSFW-illustrious-SDXL v17 model
USE_LOCAL_SDXL=true

# URL of the local server (default: http://localhost:8000)
LOCAL_SDXL_URL=http://localhost:8000

# Path to the model directory (default: D:\anime-sdxl-v17)
LOCAL_SDXL_PATH=D:\anime-sdxl-v17
