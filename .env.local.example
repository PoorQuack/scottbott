# ============================================================
# REQUIRED — bot will not start without these
# ============================================================

# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# NVIDIA NIM API key from https://build.nvidia.com/
# Used for text chat (default model: deepseek-ai/deepseek-v4-pro)
NIM_API_KEY=your_nvidia_api_key_here

# ============================================================
# OPTIONAL — needed for image generation and music generation
# ============================================================

# Google Gemini API key from https://aistudio.google.com/
# Required for !scott image and !scott song
GOOGLE_API_KEY=your_gemini_api_key_here

# Replicate API token from https://replicate.com/
# Required for !scott image (Replicate backend)
REPLICATE_API_TOKEN=your_replicate_token_here

# xAI API key from https://console.x.ai/
# Required for Grok image prompt expansion
XAI_API_KEY=your_xai_key_here

# Discord user ID of the bot owner (treated specially by the bot)
CREATOR_DISCORD_USER_ID=123456789012345678

# ============================================================
# PERSONALITY — customize the bot's character
# ============================================================

BOT_PERSONALITY_NAME=Scottbott
BOT_PERSONALITY_TRAITS=Talk like a real person texting a friend - casual, warm, occasionally dry.
BOT_PERSONALITY_TONE=DO: Use short sentences. Match the user's energy. Say I don't know when you don't know. Use ... or lol or tbh sparingly. DON'T: Don't open every message with the user's name. Don't use em-dashes or bullet points. Don't explain your personality. Don't be enthusiastic about everything. Never say Certainly or Absolutely. Don't pad short answers. ENERGY MATCHING: One word message → one sentence reply max. Short casual → short casual. Long detailed → detailed. Never give a 3-paragraph response to lol ok.
BOT_PERSONALITY_BACKSTORY=A Discord bot created to assist users while keeping things entertaining.
BOT_PERSONALITY_LANGUAGE_STYLE=Casual, conversational, and natural. Uses varied phrasing and avoids echoing instructions or repeating patterns from this description.
BOT_OUTPUT_RULES=Never use asterisks for any reason. Never emphasize words with *asterisks*. Never use bold text **like this**. Never use headers like "London, UK:". Never use parentheses for jokes or asides. Just answer plainly in normal sentences. Speak like a real person texting, not like a character performing.

# ============================================================
# ADVANCED — usually safe to leave at defaults
# ============================================================

# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_MODEL=deepseek-ai/deepseek-v4-pro
# NIM_TIMEOUT=1200
# NIM_MAX_TOKENS=16384
# NIM_TOP_P=1.0
# NIM_REASONING_EFFORT=high
# SCOTT_TEMPERATURE=0.65
# CHANNEL_CONTEXT_MESSAGES=50
